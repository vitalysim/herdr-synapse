{
 "name": "agent-board",
 "about": "QA phase 2 LLM-contract trial: the worked examples (a grouped flowchart, a mind map, a kanban with a place-in move, a composed section with orthogonal arrows and a callout, a table and a timeline, a sketch on a local grid) written fresh by an agent that read only the canvas guides: structure, relations and tones, never coordinates, on one board.",
 "gates": {
  "strict": true
 },
 "ops": [
  {
   "op": "graph",
   "id": "incident",
   "title": "Incident response",
   "layout": "flow",
   "direction": "right",
   "intent": "show how a page becomes a fix",
   "groups": [
    {
     "id": "oncall",
     "title": "On-call",
     "tone": "warning"
    },
    {
     "id": "eng",
     "title": "Engineering",
     "tone": "info"
    }
   ],
   "nodes": [
    {
     "id": "alert",
     "text": "Pager alert fires",
     "icon": "bell"
    },
    {
     "id": "ack",
     "text": "Acknowledge within 5 min",
     "in": "oncall"
    },
    {
     "id": "sev",
     "text": "Customer impact?",
     "kind": "diamond",
     "in": "oncall"
    },
    {
     "id": "war",
     "text": "Open incident channel",
     "in": "eng",
     "icon": "message-square"
    },
    {
     "id": "fix",
     "text": "Ship the mitigation",
     "in": "eng",
     "tone": "success"
    },
    {
     "id": "log",
     "text": "Log it for the weekly review",
     "tone": "neutral",
     "detail": "Low severity: no status page"
    },
    {
     "id": "pm",
     "text": "Write the postmortem",
     "kind": "note"
    }
   ],
   "edges": [
    "alert -> ack",
    "ack -> sev",
    "sev -> war: yes",
    "sev -> log: no",
    "war -> fix",
    "fix -> pm",
    "log --> pm: weekly"
   ],
   "same_rank": [
    [
     "war",
     "log"
    ]
   ]
  },
  {
   "op": "mindmap",
   "id": "spring",
   "title": "Spring campaign",
   "right_of": "incident",
   "gap": "l",
   "intent": "brainstorm the spring campaign with marketing",
