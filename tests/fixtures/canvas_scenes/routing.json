      {"op": "shape", "id": "b1", "text": "Server", "at": [520, 0], "intent": "right end"},
      {"op": "shape", "id": "a2", "text": "Producer", "at": [0, 320], "intent": "left end"},
      {"op": "shape", "id": "w2", "text": "Queue", "at": [260, 300], "w": 160, "h": 120, "kind": "ellipse", "intent": "in the way"},
      {"op": "shape", "id": "b2", "text": "Consumer", "at": [520, 380], "intent": "right end"},
      {"op": "shape", "id": "a3", "text": "Draft", "at": [0, 560], "intent": "left end"},
      {"op": "shape", "id": "b3", "text": "Review", "at": [520, 660], "intent": "right end"},
