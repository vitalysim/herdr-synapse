    {"op": "heading", "id": "title", "text": "Checkout revamp", "level": 1, "at": [0, 0], "intent": "the board title"},
    {"op": "section", "id": "now", "title": "In flight", "layout": "row", "gap": "m", "below": "title", "intent": "what is in flight"},
