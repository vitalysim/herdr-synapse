{"v":1,"team":"qa","version":8,"updated_at":"2026-09-20T10:00:00.000Z","elements":[{"id":"E-1","type":"text","alias":"h1","client_id":null,"x":0,"y":0,"w":495,"h":135,"text":"Decision record: move the nightly export to the new queue","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":36,"rough":1},"frame":null,"group":null,"role":null,"z":1,"author":"qa-drawer","author_kind":"member","intent":"the heading","batch":"B-1","created_seq":1,"updated_seq":1,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":false},{"id":"E-2","type":"text","alias":"para","client_id":null,"x":0,"y":155,"w":594,"h":175,"text":"Context. The nightly export has failed four times this month because the old queue drops jobs larger than 64 MB. The new queue streams in chunks, keeps a dead-letter topic, and already runs the invoice pipeline without incident since July. Moving the export costs about two days of work and removes the manual re-run that on-call does every Monday.","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":2,"author":"qa-drawer","author_kind":"member","intent":"an auto-sized paragraph","batch":"B-1","created_seq":2,"updated_seq":2,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":false},{"id":"E-3","type":"text","alias":"narrow","client_id":null,"x":0,"y":370,"w":100,"h":150,"text":"Owner: platform team. Reviewers: data, finance.","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":3,"author":"qa-drawer","author_kind":"member","intent":"a 100-unit column","batch":"B-1","created_seq":3,"updated_seq":3,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":true},{"id":"E-4","type":"text","alias":"list","client_id":null,"x":140,"y":370,"w":220,"h":200,"text":"Options\n- keep the old queue and raise the limit\n- move to the new queue\n\nChosen: move to the new queue","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":4,"author":"qa-drawer","author_kind":"member","intent":"a list in a 220-unit column","batch":"B-1","created_seq":4,"updated_seq":4,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":true},{"id":"E-5","type":"text","alias":"indent","client_id":null,"x":400,"y":370,"w":352,"h":100,"text":"Rollout\n    step 1: dual-write for a week\n    step 2: compare row counts daily\n    step 3: switch the reader","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":5,"author":"qa-drawer","author_kind":"member","intent":"indented lines","batch":"B-1","created_seq":5,"updated_seq":5,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":false},{"id":"E-6","type":"text","alias":"path","client_id":null,"x":0,"y":580,"w":594,"h":75,"text":"Runbook: /srv/runbooks/data-platform/exports/nightly-export-to-streaming-queue-migration.md","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"hand","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":6,"author":"qa-drawer","author_kind":"member","intent":"a long path","batch":"B-1","created_seq":6,"updated_seq":6,"created_at":"2026-09-20T10:00:00.000Z","updated_at":"2026-09-20T10:00:00.000Z","wrap":false},{"id":"E-7","type":"text","alias":"code","client_id":null,"x":0,"y":695,"w":550,"h":50,"text":"queue.publish(topic=\"exports.nightly\", chunk_mb=8, dead_letter=\"exports.dlq\")","style":{"stroke":"#1971c2","fill":null,"width":2,"dash":"solid","opacity":100,"font":"code","size":20,"rough":1},"frame":null,"group":null,"role":null,"z":7,"aut