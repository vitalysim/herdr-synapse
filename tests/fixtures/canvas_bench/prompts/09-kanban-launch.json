    "status": {"Gateway JWT check": "blocked"}
  },
  "reference": [
   {"op": "kanban", "id": "launch", "title": "Launch board", "at": [0, 0], "intent": "track launch tasks", "columns": [{"id": "todo", "title": "Todo", "cards": ["Rotate API keys", {"title": "Landing page copy", "badges": ["P0"]}]}, {"id": "doing", "title": "Doing", "tone": "warning", "cards": [{"title": "Gateway JWT check", "status": "blocked"}]}, {"id": "done", "title": "Done", "tone": "success", "cards": ["Persona research"]}]}
  ],
  "reference_v1": [
   {"op": "frame", "id": "todo", "title": "Todo", "at": [0, 0], "w": 300, "h": 360, "intent": "launch board"},
   {"op": "shape", "kind": "note", "id": "keys", "text": "Rotate API keys", "in": "todo", "intent": "launch board"},
   {"op": "shape", "kind": "note", "id": "copy", "text": "Landing page copy (P0)", "in": "todo", "intent": "launch board"},
   {"op": "frame", "id": "doing", "title": "Doing", "right_of": "todo", "w": 300, "h": 360, "intent": "launch board"},
   {"op": "shape", "kind": "note", "id": "jwt", "text": "Gateway JWT check (blocked)", "in": "doing", "intent": "launch board"},
   {"op": "frame", "id": "done", "title": "Done", "right_of": "doing", "w": 300, "h": 360, "intent": "launch board"},
   {"op": "shape", "kind": "note", "id": "persona", "text": "Persona research", "in": "done", "intent": "launch board"}
  ]
}
