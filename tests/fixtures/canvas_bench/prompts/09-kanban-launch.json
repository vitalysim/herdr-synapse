{
  "id": "09-kanban-launch",
  "category": "kanban",
  "audience": "dev",
  "live": true,
  "prompt": "Make a launch board with Todo, Doing and Done columns. Todo has Rotate API keys and Landing page copy, which is P0. Doing has Gateway JWT check, which is blocked. Done has Persona research.",
