{
  "id": "01-flow-checkout",
  "category": "flowchart",
  "audience": "dev",
  "live": true,
  "prompt": "Draw our checkout flow: the shopper fills the cart, the cart goes to the checkout API, and the API asks whether the payment was approved. If yes, the order is saved in the orders database and a confirmation email goes out; if not, we show retry payment and send the shopper back to the cart. Put the checkout API, the payment decision and the orders database in a group called Core services.",
  "expect": {
    "kinds_any": ["graph"],
    "labels": ["Shopper", "Cart", "Checkout API", "Payment approved", "Orders database", "Confirmation email", "Retry payment", "Core services"],
    "relations": [["Shopper", "Cart"], ["Cart", "Checkout API"], ["Checkout API", "Payment approved"], ["Payment approved", "Orders database"], ["Orders database", "Confirmation email"], ["Payment approved", "Retry payment"], ["Retry payment", "Cart"], ["Core services", "Checkout API", "contains"], ["Core services", "Payment approved", "contains"], ["Core services", "Orders database", "contains"]]
  },
  "reference": [
   {"op": "graph", "id": "checkout", "title": "Checkout flow", "direction": "right", "intent": "the checkout flow for the review", "groups": [{"id": "core", "title": "Core services", "tone": "info"}], "nodes": [{"id": "shopper", "text": "Shopper", "icon": "user"}, {"id": "cart", "text": "Cart", "icon": "shopping-cart"}, {"id": "api", "text": "Checkout API", "icon": "server", "in": "core"}, {"id": "ok", "text": "Payment approved?", "kind": "diamond", "in": "core"}, {"id": "db", "text": "Orders database", "icon": "database", "in": "core"}, {"id": "mail", "text": "Confirmation email", "icon": "mail", "tone": "success"}, {"id": "retry", "text": "Retry payment", "tone": "danger"}], "edges": ["shopper -> cart", "cart -> api", "api -> ok", "ok -> db: yes", "db -> mail", "ok -> retry: no", "retry --> cart"]}
  ],
  "reference_v1": [
   {"op": "shape", "kind": "ellipse", "id": "shopper", "text": "Shopper", "at": [0, 0], "intent": "checkout flow"},
   {"op": "shape", "kind": "box", "id": "cart", "text": "Cart", "right_of": "shopper", "intent": "checkout flow"},
   {"op": "frame", "id": "core", "title": "Core services", "right_of": "cart", "w": 900, "h": 360, "intent": "core services"},
   {"op": "shape", "kind": "box", "id": "api", "text": "Checkout API", "in": "core", "intent": "checkout flow"},
   {"op": "shape", "kind": "diamond", "id": "ok", "text": "Payment approved?", "in": "core", "intent": "checkout flow"},
   {"op": "shape", "kind": "box", "id": "db", "text": "Orders database", "in": "core", "intent": "checkout flow"},
   {"op": "shape", "kind": "box", "id": "mail", "text": "Confirmation email", "right_of": "core", "intent": "checkout flow"},
   {"op": "shape", "kind": "box", "id": "retry", "text": "Retry payment", "below": "core", "intent": "checkout flow"},
   {"op": "arrow", "from": "shopper", "to": "cart", "intent": "checkout flow"},
   {"op": "arrow", "from": "cart", "to": "api", "intent": "checkout flow"},
   {"op": "arrow", "from": "api", "to": "ok", "intent": "checkout flow"},
   {"op": "arrow", "from": "ok", "to": "db", "label": "yes", "intent": "checkout flow"},
   {"op": "arrow", "from": "db", "to": "mail", "intent": "checkout flow"},
   {"op": "arrow", "from": "ok", "to": "retry", "label": "no", "intent": "checkout flow"},
   {"op": "arrow", "from": "retry", "to": "cart", "dash": "dashed", "intent": "checkout flow"}
  ]
