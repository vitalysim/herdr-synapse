  "expect": {
    "kinds_any": ["chart"],
    "labels": ["Signups per month"],
    "chart": {"type_any": ["bar", "column", "line"], "fields": []}
  },
  "reference": [
   {"op": "chart", "id": "signups", "title": "Signups per month", "type": "bar", "at": [0, 0], "intent": "signup growth", "rows": [{"month": "June", "signups": 1200}, {"month": "July", "signups": 1450}, {"month": "August", "signups": 1700}, {"month": "September", "signups": 2100}], "x": "month", "y": "signups", "types": {"month": "ordinal"}}
  ]
}
