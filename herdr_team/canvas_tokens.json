{
  "version": 1,
  "doc": ".local/prd/canvas-v2-design.md",
  "about": "Synapse canvas design tokens. Every renderer (page, Python SVG/PNG, v2 display list) reads this file; colours are chosen by meaning (tone), never by author. Units are canvas units (1 unit = 1 CSS px at 100% zoom).",
  "contrast": {"text": 4.5, "non_text": 3.0, "standard": "WCAG 2.2 AA"},
  "font": {
    "sans": {
      "family": "Inter",
      "version": "4.1",
      "license": "OFL-1.1",
      "fallback": ["Inter", "Helvetica", "Arial", "sans-serif"],
      "weights": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700}
    },
    "mono": {"family": "Geist Mono", "license": "OFL-1.1", "fallback": ["Geist Mono", "Cascadia Code", "Menlo", "monospace"]},
    "sketch": {"family": "Excalifont", "license": "OFL-1.1", "note": "opt-in sketch theme only"},
    "aliases": {"normal": "sans", "hand": "sketch", "code": "mono"},
    "default": "sans"
  },
  "type": {
    "default": "m",
    "scale": {
      "s": {"size": 16, "line": 24, "weight": 400, "use": "body text, arrow labels, card body, table cells"},
      "m": {"size": 20, "line": 28, "weight": 500, "use": "shape and sticky labels, card titles (600)"},
      "l": {"size": 28, "line": 36, "weight": 600, "use": "headings inside a section"},
      "xl": {"size": 36, "line": 44, "weight": 700, "use": "the board or area heading"}
    },
    "roles": {
      "caption": {"size": 12, "line": 16, "weight": 500, "ink": "ink_muted", "use": "chips, id badges, grid labels, metadata"},
      "label": {"size": 16, "line": 20, "weight": 500, "ink": "ink_muted", "use": "arrow label pills"},
      "section_title": {"size": 20, "line": 28, "weight": 600, "use": "v2 section band title"},
      "card_title": {"size": 20, "line": 28, "weight": 600},
      "code": {"size": 14, "line": 20, "weight": 400, "font": "mono"},
      "display": {"size": 48, "line": 60, "weight": 700, "use": "v2 board title, component-set only"}
    },
    "shrink_floor": 14,
    "tracking": 0
  },
  "space": {
    "unit": 4,
    "grid": 20,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96],
    "gap": {"s": 20, "m": 40, "l": 80},
    "pad": {"s": 20, "m": 32, "l": 48},
    "snap": "a container grown to fit its text rounds its w and h up to the next multiple of grid"
  },
  "padding": {
    "box": {"x": 16, "y": 12},
    "ellipse": {"x": 8, "y": 8, "inner": "inscribed rectangle w/sqrt(2) x h/sqrt(2)"},
    "diamond": {"x": 4, "y": 4, "inner": "inscribed rectangle w/2 x h/2"},
    "note": {"x": 16, "y": 16},
    "card": {"x": 16, "y": 16, "title_gap": 4},
    "section": {"x": 20, "y": 20, "band": {"phase0": 40, "v2": 60}},
    "arrow_label": {"x": 8, "y": 2},
    "chip": {"x": 6, "y": 2},
    "table_cell": {"x": 12, "y": 8},
    "text": {"x": 0, "y": 0}
  },
  "radius": {
    "box": 8,
    "diamond": 8,
    "card": 12,
    "note": 4,
    "section": 16,
    "image": 8,
    "table_cell": 6,
    "arrow_label": 6,
    "elbow": 8,
    "pill": 999,
    "chip": 999
  },
  "stroke": {
    "width": {"hairline": 1, "border": 1.5, "connector": 2, "emphasis": 3},
    "phase0_width": {"thin": 1, "bold": 2, "extra": 4},
    "dash": {"solid": [], "dashed": [8, 6], "dotted": [2, 6]},
    "cap": "round",
    "join": "round"
  },
  "elevation": {
    "0": "flat: sections, text, arrows, shapes",
    "1": "resting: cards, stickies, images",
    "2": "lifted: hover, drag, the selection",
    "3": "floating: menus and popovers on the page"
  },
  "size_min": {
    "box": [160, 80],
    "ellipse": [160, 80],
    "diamond": [200, 120],
    "note": [180, 120],
    "sticky": [200, 200],
    "card": [240, 80],
    "graph_node": [160, 60],
    "section": [320, 200],
    "table_cell": [120, 40],
    "kanban_column": [280, 200],
    "chip": [24, 24],
    "arrow_label": [24, 24]
  },
  "arrow": {
    "width": "connector",
    "color": "line",
    "toned_color": "stroke",
    "head": {"v2": "triangle", "phase0": "arrow", "length": 10, "width": 8},
    "route": {"default": "straight", "graph": "elbow", "clearance": 20, "corner_radius": 8},
    "label": {"role": "label", "fill": "surface", "stroke": "grid", "radius": "arrow_label", "padding": "arrow_label"},
    "dash_meaning": {"solid": "direct, synchronous, owns", "dashed": "async, optional, planned", "dotted": "weak reference, see also"}
  },
  "section": {
    "fill": "zone",
    "stroke": "zone_stroke",
    "stroke_width": "hairline",
    "radius": "section",
    "elevation": 0,
    "title": {
      "phase0": {"size": 16, "at": [20, 8], "ink": "text"},
      "v2": {"role": "section_title", "at": [20, 16], "ink": "text"}
    },
    "default_tone": "neutral",
    "band": 60,
    "title_at_y": 16,
    "min": [320, 200],
    "empty_hint": "Empty section"
  },
  "layout": {"gap": 40, "rank_gap": 80, "group_pad": [20, 40, 20, 20], "tree_gap": 24, "tree_level_gap": 60, "clearance": 20,
             "elbow_radius": 8, "port_spacing": 12},
  "lod": {"titles": 0.35, "overview": 0.15, "title_min_px": 12, "skeleton_h": 8, "skeleton_lines": 3},
  "card": {"widths": {"s": 240, "m": 320, "l": 440}, "min": [240, 80], "bar": 4, "icon": 20, "icon_indent": 28, "badge_gap": 8,
           "row_gap": 8, "owner_r": 9, "kanban_clamp": {"title": 2, "body": 3}, "timeline_clamp": {"title": 2, "body": 2},
           "bullet_indent": 16},
  "table": {"widths": {"s": 120, "m": 200, "l": 320}, "min_w": 120, "max_w": 320, "row_min": 40, "band": 40, "max_lines": 2,
            "size": {"s": 14, "m": 16}},
  "kanban": {"column_min": [280, 200], "gap": "s", "limit_over": "danger"},
  "timeline": {"card_w": 200, "min_w": 800, "gap": 20, "axis": 2, "span": 6, "level_gap": 24, "stem_gap": 16},
  "icon": {"sizes": {"s": 24, "m": 32, "l": 48, "xl": 64}, "stroke": 2, "label_max": 160, "label_gap": 6},
  "sticky": {
    "fill": "sticky",
    "text": "text",
    "stroke": {"phase0": "stroke", "v2": "none"},
    "elevation": 1,
    "radius": "note",
    "size": "m",
    "fit": "shrink",
    "default_tone": "idea",
    "meaning": {
      "idea": "idea or question",
      "info": "discussion",
      "success": "positive",
      "warning": "concern",
      "danger": "blocker",
      "accent": "highlight",
      "decision": "decided",
      "neutral": "aside"
    }
  },
  "author": {
    "chip": {
      "diameter": 24,
      "text": "caption",
      "weight": 600,
      "initials": 2,
      "offset": [-8, -8],
      "anchor": "top-right",
      "show": "hover, selection, and when zoom >= 0.5 in the page; always in the side panel"
    },
    "halo": {"width": 3, "alpha": 0.35, "gap": 4},
    "assign": "chip index = the author's roster index modulo 8; the human always uses human_chip",
    "rule": "authorship never changes stroke, fill or text colour"
  },
  "tones": ["neutral", "info", "success", "warning", "danger", "accent", "idea", "decision"],
  "roles": {
    "fill": "soft tinted background of a shape or card",
    "stroke": "shape outline and toned arrows, >= 3:1 on canvas, surface and fill",
    "text": "ink on fill, sticky, zone, canvas and surface, >= 4.5:1",
    "solid": "strong background for the solid variant and badges, >= 3:1 on canvas",
    "on_solid": "text on solid, >= 4.5:1",
    "sticky": "sticky-note paper",
    "zone": "section (frame) tint",
    "zone_stroke": "section hairline, decorative"
  },
  "legacy": {
    "color": {
      "black": "neutral",
      "gray": "neutral",
      "white": "neutral",
      "blue": "info",
      "green": "success",
      "orange": "warning",
      "yellow": "idea",
      "red": "danger",
      "pink": "danger",
      "purple": "accent",
      "teal": "decision"
    },
    "stroke_hex": {
      "#1e1e1e": "neutral",
      "#868e96": "neutral",
      "#e03131": "danger",
      "#c2255c": "danger",
      "#9c36b5": "accent",
      "#1971c2": "info",
      "#0c8599": "decision",
      "#2f9e44": "success",
      "#f08c00": "warning",
      "#f59f00": "idea",
      "#5c940d": "success",
      "#ffffff": "neutral"
    },
    "fill_hex": {
      "#ffc9c9": "danger",
      "#fcc2d7": "danger",
      "#eebefa": "accent",
      "#a5d8ff": "info",
      "#99e9f2": "decision",
      "#b2f2bb": "success",
      "#ffec99": "idea",
      "#ffd8a8": "warning",
      "#e9ecef": "neutral",
      "#d8f5a2": "success",
      "#ffffff": "neutral"
    },
    "note_fill": "#ffec99"
  },
  "phase0_excalidraw": {
    "roughness": 0,
    "fillStyle": "solid",
    "strokeStyle": {"solid": "solid", "dashed": "dashed", "dotted": "dotted"},
    "fontFamily": {"sans": 2, "sketch": 5, "mono": 3},
    "font_face": {
      "family": "Helvetica",
      "weight": 500,
      "why": "family 2 is Excalidraw's only local font: it registers no FontFace for it, so the page's @font-face named Helvetica (Inter Medium, bundled) is what the canvas draws"
    },
    "lineHeight": {"s": 1.5, "m": 1.4, "l": 1.2857, "xl": 1.2222},
    "roundness": {
      "box": {"type": 3, "value": 8},
      "note": {"type": 3, "value": 4},
      "diamond": {"type": 3, "value": 8},
      "ellipse": null,
      "arrow_curve": {"type": 2}
    },
    "arrowhead": {"arrow": "arrow", "triangle": "triangle", "dot": "dot", "none": null},
    "frameRendering": {"enabled": true, "clip": true, "name": false, "outline": false},
    "viewBackgroundColor": "canvas",
    "dark_mode": "Excalidraw's own filter invert(93%) hue-rotate(180deg) over the light tokens; every pair was checked through it",
    "currentItem": {
      "roughness": 0,
      "fontFamily": 2,
      "fontSize": 20,
      "strokeWidth": 2,
      "strokeColor": "ink",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "roundness": "round"
    }
  },
